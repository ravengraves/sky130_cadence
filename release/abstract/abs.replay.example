;; Abstract reads plain Liberty: gunzip -k ../tech/sky130_fd_sc_hs__ss_150C_1v60.lib.gz first
absSetOption("LEFLibraryName" "abs_fdsc")
absSetOption("ImportLefFiles" "../tech/sky130_fd_sc_hs_innovus.tlef")
absSetOption("ImportTechLef" "true")
absImportLEF()
absSetLibrary("abs_fdsc")
absSetOption("DefaultBin" "Core")
absSetOption("ImportGDSIIFiles" "../tech/gds/sky130_fd_sc_hs__inv_1.gds")
absSetOption("ImportGDSIILayerMapFile" "layers.map")
absImportGDS()
absSetLibrary("abs_fdsc")
absSetOption("ImportLogicalType" "LIB")
absSetOption("ImportLIBFiles" "../tech/sky130_fd_sc_hs__ss_150C_1v60.lib")
absSetOption("ImportLogicalFiles" "../tech/sky130_fd_sc_hs__ss_150C_1v60.lib")
absImportLogical()
absSetLibrary("abs_fdsc")
absSetBinOption("Core" "PinsTextPinMap" "((li1 label) (li1 pin)) ((met1 label) (met1 pin))")
absSetBinOption("Core" "PinsPowerNames" "^(VPWR|VPB)$")
absSetBinOption("Core" "PinsGroundNames" "^(VGND|VNB)$")
absSetBinOption("Core" "PinsBoundaryLayers" "prBoundary")
absSetBinOption("Core" "ExtractLayersSig" "li1 met1 met2")
absSetBinOption("Core" "ExtractLayersPwr" "li1 met1 met2")
absSetBinOption("Core" "ExtractPinLayersSig" "li1 met1 met2")
absSetBinOption("Core" "ExtractPinLayersPwr" "li1 met1 met2")
absSetBinOption("Core" "AbstractBlockageDetailedLayers" "li1 mcon met1")
absSetBinOption("Core" "AbstractSiteName" "unit")
absSelectBin("Core")
absSelectCells()
absPins()
absExtract()
absSetCellProp("sky130_fd_sc_hs__inv_1" "symmetry" "X Y")
absAbstract()
absSetOption("ExportLEFFile" "inv_1.lef")
absSetOption("ExportLEFBin" "Core")
absExportLEF()
absExit()
