// SkyWater sky130 DRC for Pegasus, generated by sky130cad/drc_deck.py.
// Values: SkyWater periphery rules via efabless sky130A_mr.drc / open_pdks sky130.lydrc.
// Style: Cadence GPDK045 pvs/pvlDRC.rul.
// Not implemented: density, antenna, latch-up tap distance, licon.12 (NC), area-id
// relaxations, resistor/varactor/ESD/HV rules. nwell.4 applies to blocks, not lone cells.
results_db -drc "sky130_full.drc_errors.ascii" -ascii;
max_results -drc all;
grid 5;
unit -length u;
text_depth -primary;
flag -nonsimple yes;


layer_def dnwell 1000;
layer_map 64 -datatype 18 1000;
layer_def nwell 1001;
layer_map 64 -datatype 20 1001;
layer_def diff 1002;
layer_map 65 -datatype 20 1002;
layer_def tap 1003;
layer_map 65 -datatype 44 1003;
layer_def poly 1004;
layer_map 66 -datatype 20 1004;
layer_def licon 1005;
layer_map 66 -datatype 44 1005;
layer_def npc 1006;
layer_map 95 -datatype 20 1006;
layer_def nsdm 1007;
layer_map 93 -datatype 44 1007;
layer_def psdm 1008;
layer_map 94 -datatype 20 1008;
layer_def hvtp 1009;
layer_map 78 -datatype 44 1009;
layer_def lvtn 1010;
layer_map 125 -datatype 44 1010;
layer_def hvi 1011;
layer_map 75 -datatype 20 1011;
layer_def li1 1012;
layer_map 67 -datatype 20 1012;
layer_def mcon 1013;
layer_map 67 -datatype 44 1013;
layer_def met1 1014;
layer_map 68 -datatype 20 1014;
layer_def via 1015;
layer_map 68 -datatype 44 1015;
layer_def met2 1016;
layer_map 69 -datatype 20 1016;
layer_def via2 1017;
layer_map 69 -datatype 44 1017;
layer_def met3 1018;
layer_map 70 -datatype 20 1018;
layer_def via3 1019;
layer_map 70 -datatype 44 1019;
layer_def met4 1020;
layer_map 71 -datatype 20 1020;
layer_def via4 1021;
layer_map 71 -datatype 44 1021;
layer_def met5 1022;
layer_map 72 -datatype 20 1022;
layer_def pad 1023;
layer_map 76 -datatype 20 1023;
layer_def areaid_sc 1024;
layer_map 81 -datatype 4 1024;
layer_def areaid_ce 1025;
layer_map 81 -datatype 2 1025;

or diff tap difftap;
and poly diff gate;
and diff psdm pdiff;
and diff nsdm ndiff;
and tap nsdm ntap;
and tap psdm ptap;
and licon diff licon_diff;
and licon tap licon_tap;
and licon poly licon_poly;
not poly diff poly_field;
or poly difftap polydifftap;
and difftap nsdm ndifftap;
and difftap psdm pdifftap;
or nsdm psdm npsdm;
and nsdm psdm bothimp;
not diff gate sd;

rule x.1b_offgrid {
    caption x.1b: OFFGRID vertex, 0.005um grid;
    layout_input -offgrid;
}
rule x.3a_angle {
    caption x.3a: non 45 degree angle;
    layout_input -skew;
}
rule x.acute {
    caption x.acute: acute angle;
    layout_input -acute;
}
rule x.2_diff {
    caption x.2: non 90 degree angle on diff;
    angle diff -ltgt 0 90;
}
rule x.2_tap {
    caption x.2: non 90 degree angle on tap;
    angle tap -ltgt 0 90;
}
rule x.2_poly {
    caption x.2: non 90 degree angle on poly;
    angle poly -ltgt 0 90;
}
rule x.2_licon {
    caption x.2: non 90 degree angle on licon;
    angle licon -ltgt 0 90;
}
rule x.2_mcon {
    caption x.2: non 90 degree angle on mcon;
    angle mcon -ltgt 0 90;
}
rule x.2_via {
    caption x.2: non 90 degree angle on via;
    angle via -ltgt 0 90;
}
rule x.2_via2 {
    caption x.2: non 90 degree angle on via2;
    angle via2 -ltgt 0 90;
}
rule x.2_via3 {
    caption x.2: non 90 degree angle on via3;
    angle via3 -ltgt 0 90;
}
rule x.2_via4 {
    caption x.2: non 90 degree angle on via4;
    angle via4 -ltgt 0 90;
}
rule nwell.1 {
    caption nwell.1: min. nwell width : 0.84um;
    inte nwell nwell -lt 0.84 -output region -singular -abut lt 90;
}
rule nwell.2a {
    caption nwell.2a: min. nwell spacing : 1.27um;
    exte nwell nwell -lt 1.27 -output region -singular -abut lt 90;
}
rule difftap.1 {
    caption difftap.1: min. diff width : 0.15um;
    inte diff diff -lt 0.15 -output region -singular -abut lt 90;
}
rule difftap.1_c {
    caption difftap.1_c: min. tap width : 0.15um;
    inte tap tap -lt 0.15 -output region -singular -abut lt 90;
}
rule difftap.3 {
    caption difftap.3: min. difftap spacing : 0.27um;
    exte difftap difftap -lt 0.27 -output region -singular -abut lt 90;
}
rule difftap.8 {
    caption difftap.8: min. p+diff enclosure by nwell : 0.18um;
    enc pdiff nwell -lt 0.18 -output region -singular -abut lt 90 -outside_also;
}
rule difftap.9 {
    caption difftap.9: min. n+diff spacing to nwell : 0.34um;
    exte ndiff nwell -lt 0.34 -output region -singular -abut lt 90;
}
rule difftap.10 {
    caption difftap.10: min. n+tap enclosure by nwell : 0.18um;
    enc ntap nwell -lt 0.18 -output region -singular -abut lt 90 -outside_also;
}
rule difftap.11 {
    caption difftap.11: min. p+tap spacing to nwell : 0.13um;
    exte ptap nwell -lt 0.13 -output region -singular -abut lt 90;
}
rule poly.1a {
    caption poly.1a: min. poly width : 0.15um;
    inte poly poly -lt 0.15 -output region -singular -abut lt 90;
}
rule poly.2 {
    caption poly.2: min. poly spacing : 0.21um;
    exte poly poly -lt 0.21 -output region -singular -abut lt 90;
}
rule poly.4 {
    caption poly.4: min. poly on field spacing to diff : 0.075um;
    exte poly_field diff -lt 0.075 -metric opposite -output region -singular;
}
rule poly.5 {
    caption poly.5: min. poly on field spacing to tap : 0.055um;
    exte poly_field tap -lt 0.055 -output region -singular -abut lt 90;
}
rule npc.1 {
    caption npc.1: min. npc width : 0.27um;
    inte npc npc -lt 0.27 -output region -singular -abut lt 90;
}
rule npc.2 {
    caption npc.2: min. npc spacing : 0.27um;
    exte npc npc -lt 0.27 -output region -singular -abut lt 90;
}
rule nsdm.2 {
    caption nsdm.2: min. nsdm width : 0.38um;
    inte nsdm nsdm -lt 0.38 -output region -singular -abut lt 90;
}
rule nsdm.1 {
    caption nsdm.1: min. nsdm spacing : 0.38um;
    exte nsdm nsdm -lt 0.38 -output region -singular -abut lt 90;
}
rule psdm.2 {
    caption psdm.2: min. psdm width : 0.38um;
    inte psdm psdm -lt 0.38 -output region -singular -abut lt 90;
}
rule psdm.1 {
    caption psdm.1: min. psdm spacing : 0.38um;
    exte psdm psdm -lt 0.38 -output region -singular -abut lt 90;
}
rule hvtp.1 {
    caption hvtp.1: min. hvtp width : 0.38um;
    inte hvtp hvtp -lt 0.38 -output region -singular -abut lt 90;
}
rule hvtp.2 {
    caption hvtp.2: min. hvtp spacing : 0.38um;
    exte hvtp hvtp -lt 0.38 -output region -singular -abut lt 90;
}
rule lvtn.1a {
    caption lvtn.1a: min. lvtn width : 0.38um;
    inte lvtn lvtn -lt 0.38 -output region -singular -abut lt 90;
}
rule lvtn.2 {
    caption lvtn.2: min. lvtn spacing : 0.38um;
    exte lvtn lvtn -lt 0.38 -output region -singular -abut lt 90;
}
rule licon.1_a {
    caption licon.1_a: min. licon width : 0.17um;
    inte licon licon -lt 0.17 -output region -singular -abut lt 90;
}
rule licon.1_b {
    caption licon.1_b: licon must be a 0.17um square;
    area -not licon -eq 0.0289;
}
rule licon.2 {
    caption licon.2: min. licon spacing : 0.17um;
    exte licon licon -lt 0.17 -output region -singular -abut lt 90;
}
rule licon.4 {
    caption licon.4: licon must be covered by li1;
    not licon li1;
}
rule licon.4b {
    caption licon.4b: licon must be on poly, diff or tap;
    not licon polydifftap;
}
rule licon.5 {
    caption licon.5: min. diff enclosure of licon : 0.04um;
    enc licon_diff diff -lt 0.04 -output region -singular -abut lt 90 -outside_also;
}
rule licon.8 {
    caption licon.8: min. poly enclosure of licon : 0.05um;
    enc licon_poly poly -lt 0.05 -output region -singular -abut lt 90 -outside_also;
}
rule licon.11a {
    caption licon.11a: min. licon spacing to gate (std-cell value) : 0.05um;
    exte licon_diff gate -lt 0.05 -output region -singular -abut lt 90;
}
rule licon.14 {
    caption licon.14: min. poly licon spacing to difftap : 0.19um;
    exte licon_poly difftap -lt 0.19 -output region -singular -abut lt 90;
}
rule licon.9 {
    caption licon.9: min. poly licon spacing to psdm, no overlap : 0.11um;
    exte licon_poly psdm -lt 0.11 -output region -singular -abut lt 90 licon_9_s;
    and licon_poly psdm licon_9_o;
    or licon_9_s licon_9_o;
}
rule nwell.4 {
    caption nwell.4: every nwell must contain a contacted tap (licon on tap);
    select -interact -not nwell licon_tap;
}
rule nsd.5a {
    caption nsd.5a: min. nsdm enclosure of diff except butting edges : 0.125um;
    enc ndiff nsdm -lt 0.125 -output region -singular -abut lt 90 -outside_also nsd_5a_e;
    select -interact -not nsd_5a_e pdifftap;
}
rule nsd.5b {
    caption nsd.5b: min. nsdm enclosure of tap except butting edges : 0.125um;
    enc ntap nsdm -lt 0.125 -output region -singular -abut lt 90 -outside_also nsd_5b_e;
    select -interact -not nsd_5b_e pdifftap;
}
rule nsd.7 {
    caption nsd.7: min. nsdm spacing to opposite-implant diff/tap : 0.13um;
    exte nsdm pdifftap -lt 0.13 -output region -singular;
}
rule psd.5a {
    caption psd.5a: min. psdm enclosure of diff except butting edges : 0.125um;
    enc pdiff psdm -lt 0.125 -output region -singular -abut lt 90 -outside_also psd_5a_e;
    select -interact -not psd_5a_e ndifftap;
}
rule psd.5b {
    caption psd.5b: min. psdm enclosure of tap except butting edges : 0.125um;
    enc ptap psdm -lt 0.125 -output region -singular -abut lt 90 -outside_also psd_5b_e;
    select -interact -not psd_5b_e ndifftap;
}
rule psd.7 {
    caption psd.7: min. psdm spacing to opposite-implant diff/tap : 0.13um;
    exte psdm ndifftap -lt 0.13 -output region -singular;
}
rule npsd.8 {
    caption n/psd.8: nsdm and psdm must not overlap diff/tap of opposite doping;
    and bothimp difftap;
}
rule npsd.9 {
    caption n/psd.9: diff and tap must be enclosed by nsdm or psdm;
    not difftap npsdm;
}
rule nsd.10a {
    caption nsd.10a: min. nsdm area : 0.265um2;
    area nsdm -lt 0.265;
}
rule psd.10b {
    caption psd.10b: min. psdm area : 0.255um2;
    area psdm -lt 0.255;
}
rule nsd.11 {
    caption nsd.11: min. nsdm hole area : 0.265um2;
    holes nsdm -lt 0.265;
}
rule psd.11 {
    caption psd.11: min. psdm hole area : 0.265um2;
    holes psdm -lt 0.265;
}
rule licon.15 {
    caption licon.15: min. npc enclosure of poly licon : 0.1um;
    enc licon_poly npc -lt 0.1 -output region -singular -abut lt 90 -outside_also;
}
rule licon.16 {
    caption licon.16: every tap and every end source/drain region must enclose a licon;
    select -interact -not tap licon licon_16_t;
    select -interact sd gate -eq 1 licon_16_e;
    select -interact -not licon_16_e licon licon_16_s;
    or licon_16_t licon_16_s;
}
rule licon.18 {
    caption licon.18: npc must enclose a poly licon;
    select -interact -not npc licon_poly;
}
rule li.1 {
    caption li.1: min. li1 width : 0.17um;
    inte li1 li1 -lt 0.17 -output region -singular -abut lt 90;
}
rule li.3 {
    caption li.3: min. li1 spacing : 0.17um;
    exte li1 li1 -lt 0.17 -output region -singular -abut lt 90;
}
rule li.6 {
    caption li.6: min. li1 area : 0.0561um2;
    area li1 -lt 0.0561;
}
rule li.5 {
    caption li.5: min. li enclosure of licon on one of 2 adjacent edges : 0.08um;
    select -interact licon li1 li_5_in;
    shift -xy 0 -0.165 li_5_in li_5_sb;
    and li_5_in li_5_sb li_5_eb;
    shift -xy 0 0.165 li_5_in li_5_st;
    and li_5_in li_5_st li_5_et;
    shift -xy -0.165 0 li_5_in li_5_sl;
    and li_5_in li_5_sl li_5_el;
    shift -xy 0.165 0 li_5_in li_5_sr;
    and li_5_in li_5_sr li_5_er;
    and li_5_eb li_5_el li_5_bl_q;
    grow li_5_bl_q -left 0.08 li_5_bl_pl;
    select -inside -not li_5_bl_pl li1 li_5_bl_xl;
    select -interact li_5_in li_5_bl_xl li_5_bl_h;
    grow li_5_bl_q -bottom 0.08 li_5_bl_pb;
    select -inside -not li_5_bl_pb li1 li_5_bl_xb;
    select -interact li_5_bl_h li_5_bl_xb li_5_bl;
    and li_5_eb li_5_er li_5_br_q;
    grow li_5_br_q -right 0.08 li_5_br_pr;
    select -inside -not li_5_br_pr li1 li_5_br_xr;
    select -interact li_5_in li_5_br_xr li_5_br_h;
    grow li_5_br_q -bottom 0.08 li_5_br_pb;
    select -inside -not li_5_br_pb li1 li_5_br_xb;
    select -interact li_5_br_h li_5_br_xb li_5_br;
    and li_5_et li_5_el li_5_tl_q;
    grow li_5_tl_q -left 0.08 li_5_tl_pl;
    select -inside -not li_5_tl_pl li1 li_5_tl_xl;
    select -interact li_5_in li_5_tl_xl li_5_tl_h;
    grow li_5_tl_q -top 0.08 li_5_tl_pt;
    select -inside -not li_5_tl_pt li1 li_5_tl_xt;
    select -interact li_5_tl_h li_5_tl_xt li_5_tl;
    and li_5_et li_5_er li_5_tr_q;
    grow li_5_tr_q -right 0.08 li_5_tr_pr;
    select -inside -not li_5_tr_pr li1 li_5_tr_xr;
    select -interact li_5_in li_5_tr_xr li_5_tr_h;
    grow li_5_tr_q -top 0.08 li_5_tr_pt;
    select -inside -not li_5_tr_pt li1 li_5_tr_xt;
    select -interact li_5_tr_h li_5_tr_xt li_5_tr;
    or li_5_bl li_5_br li_5_o1;
    or li_5_tl li_5_tr li_5_o2;
    or li_5_o1 li_5_o2;
}
rule ct.1_a {
    caption ct.1_a: min. mcon width : 0.17um;
    inte mcon mcon -lt 0.17 -output region -singular -abut lt 90;
}
rule ct.1_b {
    caption ct.1_b: mcon must be a 0.17um square;
    area -not mcon -eq 0.0289;
}
rule ct.2 {
    caption ct.2: min. mcon spacing : 0.19um;
    exte mcon mcon -lt 0.19 -output region -singular -abut lt 90;
}
rule ct.4 {
    caption ct.4: mcon must be covered by li1;
    not mcon li1;
}
rule m1.4_a {
    caption m1.4_a: mcon must be enclosed by met1;
    not mcon met1;
}
rule m1.4 {
    caption m1.4: min. met1 enclosure of mcon : 0.03um;
    enc mcon met1 -lt 0.03 -output region -singular -abut lt 90 -outside_also;
}
rule m1.5 {
    caption m1.5: min. met1 enclosure of mcon on one of 2 adjacent edges : 0.06um;
    select -interact mcon met1 m1_5_in;
    shift -xy 0 -0.165 m1_5_in m1_5_sb;
    and m1_5_in m1_5_sb m1_5_eb;
    shift -xy 0 0.165 m1_5_in m1_5_st;
    and m1_5_in m1_5_st m1_5_et;
    shift -xy -0.165 0 m1_5_in m1_5_sl;
    and m1_5_in m1_5_sl m1_5_el;
    shift -xy 0.165 0 m1_5_in m1_5_sr;
    and m1_5_in m1_5_sr m1_5_er;
    and m1_5_eb m1_5_el m1_5_bl_q;
    grow m1_5_bl_q -left 0.06 m1_5_bl_pl;
    select -inside -not m1_5_bl_pl met1 m1_5_bl_xl;
    select -interact m1_5_in m1_5_bl_xl m1_5_bl_h;
    grow m1_5_bl_q -bottom 0.06 m1_5_bl_pb;
    select -inside -not m1_5_bl_pb met1 m1_5_bl_xb;
    select -interact m1_5_bl_h m1_5_bl_xb m1_5_bl;
    and m1_5_eb m1_5_er m1_5_br_q;
    grow m1_5_br_q -right 0.06 m1_5_br_pr;
    select -inside -not m1_5_br_pr met1 m1_5_br_xr;
    select -interact m1_5_in m1_5_br_xr m1_5_br_h;
    grow m1_5_br_q -bottom 0.06 m1_5_br_pb;
    select -inside -not m1_5_br_pb met1 m1_5_br_xb;
    select -interact m1_5_br_h m1_5_br_xb m1_5_br;
    and m1_5_et m1_5_el m1_5_tl_q;
    grow m1_5_tl_q -left 0.06 m1_5_tl_pl;
    select -inside -not m1_5_tl_pl met1 m1_5_tl_xl;
    select -interact m1_5_in m1_5_tl_xl m1_5_tl_h;
    grow m1_5_tl_q -top 0.06 m1_5_tl_pt;
    select -inside -not m1_5_tl_pt met1 m1_5_tl_xt;
    select -interact m1_5_tl_h m1_5_tl_xt m1_5_tl;
    and m1_5_et m1_5_er m1_5_tr_q;
    grow m1_5_tr_q -right 0.06 m1_5_tr_pr;
    select -inside -not m1_5_tr_pr met1 m1_5_tr_xr;
    select -interact m1_5_in m1_5_tr_xr m1_5_tr_h;
    grow m1_5_tr_q -top 0.06 m1_5_tr_pt;
    select -inside -not m1_5_tr_pt met1 m1_5_tr_xt;
    select -interact m1_5_tr_h m1_5_tr_xt m1_5_tr;
    or m1_5_bl m1_5_br m1_5_o1;
    or m1_5_tl m1_5_tr m1_5_o2;
    or m1_5_o1 m1_5_o2;
}
rule m1.1 {
    caption m1.1: min. met1 width : 0.14um;
    inte met1 met1 -lt 0.14 -output region -singular -abut lt 90;
}
rule m1.2 {
    caption m1.2: min. met1 spacing : 0.14um;
    exte met1 met1 -lt 0.14 -output region -singular -abut lt 90;
}
rule m1.3ab {
    caption m1.3ab: min. spacing to met1 wider than 3um : 0.28um;
    size met1 -by -1.5 met1_nm1_3ab;
    size met1_nm1_3ab -by 1.5 met1_wm1_3ab;
    exte met1_wm1_3ab met1 -lt 0.28 -output region -singular -abut lt 90;
}
rule m1.6 {
    caption m1.6: min. met1 area : 0.083um2;
    area met1 -lt 0.083;
}
rule m1.7 {
    caption m1.7: min. met1 hole area : 0.14um2;
    holes met1 -lt 0.14;
}
rule m2.1 {
    caption m2.1: min. met2 width : 0.14um;
    inte met2 met2 -lt 0.14 -output region -singular -abut lt 90;
}
rule m2.2 {
    caption m2.2: min. met2 spacing : 0.14um;
    exte met2 met2 -lt 0.14 -output region -singular -abut lt 90;
}
rule m2.3ab {
    caption m2.3ab: min. spacing to met2 wider than 3um : 0.28um;
    size met2 -by -1.5 met2_nm2_3ab;
    size met2_nm2_3ab -by 1.5 met2_wm2_3ab;
    exte met2_wm2_3ab met2 -lt 0.28 -output region -singular -abut lt 90;
}
rule m2.6 {
    caption m2.6: min. met2 area : 0.0676um2;
    area met2 -lt 0.0676;
}
rule m2.7 {
    caption m2.7: min. met2 hole area : 0.14um2;
    holes met2 -lt 0.14;
}
rule m3.1 {
    caption m3.1: min. met3 width : 0.3um;
    inte met3 met3 -lt 0.3 -output region -singular -abut lt 90;
}
rule m3.2 {
    caption m3.2: min. met3 spacing : 0.3um;
    exte met3 met3 -lt 0.3 -output region -singular -abut lt 90;
}
rule m3.3ab {
    caption m3.3ab: min. spacing to met3 wider than 3um : 0.4um;
    size met3 -by -1.5 met3_nm3_3ab;
    size met3_nm3_3ab -by 1.5 met3_wm3_3ab;
    exte met3_wm3_3ab met3 -lt 0.4 -output region -singular -abut lt 90;
}
rule m3.6 {
    caption m3.6: min. met3 area : 0.24um2;
    area met3 -lt 0.24;
}
rule m3.7 {
    caption m3.7: min. met3 hole area : 0.2um2;
    holes met3 -lt 0.2;
}
rule m4.1 {
    caption m4.1: min. met4 width : 0.3um;
    inte met4 met4 -lt 0.3 -output region -singular -abut lt 90;
}
rule m4.2 {
    caption m4.2: min. met4 spacing : 0.3um;
    exte met4 met4 -lt 0.3 -output region -singular -abut lt 90;
}
rule m4.3ab {
    caption m4.3ab: min. spacing to met4 wider than 3um : 0.4um;
    size met4 -by -1.5 met4_nm4_3ab;
    size met4_nm4_3ab -by 1.5 met4_wm4_3ab;
    exte met4_wm4_3ab met4 -lt 0.4 -output region -singular -abut lt 90;
}
rule m4.6 {
    caption m4.6: min. met4 area : 0.24um2;
    area met4 -lt 0.24;
